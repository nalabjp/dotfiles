{{- $machine := promptStringOnce . "machine" "machine name (maui or capri)" -}}

sourceDir = {{ (joinPath .chezmoi.homeDir "src" "nalabjp" "dotfiles") | quote }}

# 秘密情報（~/.zshrc.local）は age で暗号化する。鍵の扱いは README を参照。
encryption = "age"

[data]
    machine = {{ $machine | quote }}

[age]
    identity = {{ (joinPath .chezmoi.homeDir ".config" "chezmoi" "key.txt") | quote }}
    recipient = "age1mxl2rl4t2k7h90d0hcs280m3uz5xxeu0gppevcm4tqxz07pvcuwsjyj3wa"
