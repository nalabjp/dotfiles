{{- $m := .machine -}}
#!/bin/bash
set -euo pipefail

{{ template "brew-shellenv.sh" . }}

# Brewfile hash: {{ include "dot_config/homebrew/Brewfile.tmpl" | sha256sum }}
# Brewfile.mas hash: {{ include "dot_config/homebrew/Brewfile.mas.tmpl" | sha256sum }}

brewfile="${HOME}/.config/homebrew/Brewfile"
brewfile_mas="${HOME}/.config/homebrew/Brewfile.mas"

# 更新に失敗しても（アップストリーム由来のクラッシュ等）install/cleanup は続行する
brew update || echo "warning: brew update failed (古いメタデータのまま続行します)" >&2

# 非公式 tap の formula/cask は Homebrew 6.0.0 以降 明示的な信頼が必要。
# tap 全体ではなく、宣言しているものだけを個別に信頼する。
{{ range (concat .packages.brews.shared (index .packages.brews $m) | uniq | sortAlpha) -}}
{{ if contains "/" . -}}
brew trust --formula {{ . | quote }}
{{ end -}}
{{ end -}}
{{ range (concat .packages.casks.shared (index .packages.casks $m) | uniq | sortAlpha) -}}
{{ if contains "/" . -}}
brew trust --cask {{ . | quote }}
{{ end -}}
{{ end }}
brew bundle install --file="${brewfile}"

# App Store 未サインイン等で失敗しても全体は止めない（旧 ignore_errors: yes 相当）
brew bundle install --file="${brewfile_mas}" || \
  echo "warning: mas entries failed to install (App Store のサインインを確認)" >&2

# cleanup は tap/brew/cask/mas を全て含めた状態で判定する
combined="$(mktemp)"
trap 'rm -f "${combined}"' EXIT
cat "${brewfile}" "${brewfile_mas}" > "${combined}"
brew bundle cleanup --force --file="${combined}"
