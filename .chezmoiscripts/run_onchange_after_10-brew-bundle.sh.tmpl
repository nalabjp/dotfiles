{{- $m := .machine -}}
#!/bin/bash
set -euo pipefail

{{ template "brew-shellenv.sh" . }}

# Brewfile hash: {{ includeTemplate "dot_config/homebrew/Brewfile.tmpl" . | sha256sum }}
# Brewfile.mas hash: {{ includeTemplate "dot_config/homebrew/Brewfile.mas.tmpl" . | sha256sum }}

brewfile="${HOME}/.config/homebrew/Brewfile"
brewfile_mas="${HOME}/.config/homebrew/Brewfile.mas"

# 更新に失敗しても（アップストリーム由来のクラッシュ等）install/cleanup は続行する
brew update || echo "warning: brew update failed (古いメタデータのまま続行します)" >&2

# 非公式 tap の formula/cask は Homebrew 6.0.0 以降 明示的な信頼が必要。
# formula 単位の信頼は tap 更新で失効するので、宣言している tap を tap 単位で信頼する。
{{ range (concat .packages.taps.shared (index .packages.taps $m) | uniq | sortAlpha) -}}
brew trust --tap {{ . | quote }}
{{ end }}
# 未インストールのものだけ入れる。既存パッケージの upgrade は明示的に実行する（README 参照）。
brew bundle install --no-upgrade --file="${brewfile}"

# App Store 未サインイン等で失敗しても全体は止めない（旧 ignore_errors: yes 相当）
brew bundle install --no-upgrade --file="${brewfile_mas}" || \
  echo "warning: mas entries failed to install (App Store のサインインを確認)" >&2

# cleanup は tap/brew/cask を宣言と一致させる。
# App Store のアプリは購入履歴に依存し（Apple Account 毎に再入手できないものがある）
# 誤って消すと復旧が難しいため対象外にする。
combined="$(mktemp)"
trap 'rm -f "${combined}"' EXIT
cat "${brewfile}" "${brewfile_mas}" > "${combined}"
brew bundle cleanup --force --no-mas --file="${combined}"
